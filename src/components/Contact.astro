---
import { site } from '../data/site';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';

const contactSocials = [
  { key: 'Email', href: site.socials.email, name: 'email' },
  { key: 'Instagram', href: site.socials.instagram, name: 'instagram' },
  { key: 'YouTube', href: site.socials.youtube, name: 'youtube' },
  { key: 'LinkedIn', href: site.socials.linkedin, name: 'linkedin' },
  { key: 'GitHub', href: site.socials.github, name: 'github' },
].filter((s) => s.href);
---
<section id="contact" class="section !py-8">
  <div class="container-content">
    <div class="flex flex-col items-center gap-4 text-center">
      <span class="eyebrow">Contact</span>
      <h2 class="text-xl font-semibold text-ink">Let's connect</h2>
      <div class="flex flex-wrap items-center justify-center gap-3">
        {contactSocials.map((s) => (
          <a href={s.href} target={s.name === 'email' ? undefined : '_blank'} rel="noopener noreferrer" class="group flex items-center gap-2 text-ink-muted hover:text-brand-600 transition-colors">
            <Icon name={s.name} class="h-4 w-4" />
            <span class="text-sm font-medium">{s.key}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
