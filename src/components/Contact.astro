---
import { site } from '../data/site';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';

const contactSocials = [
  { key: 'Email', href: site.socials.email, name: 'email' },
  { key: 'Instagram', href: site.socials.instagram, name: 'instagram' },
  { key: 'YouTube', href: site.socials.youtube, name: 'youtube' },
  { key: 'LinkedIn', href: site.socials.linkedin, name: 'linkedin' },
  { key: 'GitHub', href: site.socials.github, name: 'github' },
].filter((s) => s.href);
---
<section id="contact" class="section">
  <div class="container-content">
    <div class="overflow-hidden rounded-[2rem] border border-ink/[0.06] bg-gradient-to-br from-brand-500 to-brand-700 text-white shadow-card-hover">
      <div class="grid gap-10 p-8 sm:p-12 lg:grid-cols-2 lg:gap-16">
        <!-- Left -->
        <div>
          <span class="eyebrow !text-sand-300">Contact</span>
          <h2 class="mt-3 text-3xl font-semibold sm:text-4xl text-balance">Let's build something impactful together.</h2>
          <p class="mt-4 max-w-md text-white/80">
            Have a project, internship, or collaboration in mind? I'd love to hear from you — drop a message and I'll get back to you soon.
          </p>

          <div class="mt-8 space-y-3">
            {contactSocials.map((s) => (
              <a href={s.href} target={s.name === 'email' ? undefined : '_blank'} rel="noopener noreferrer" class="group flex items-center gap-3 text-white/90 hover:text-white">
                <span class="grid h-10 w-10 place-items-center rounded-full bg-white/10 transition-colors group-hover:bg-white/20">
                  <Icon name={s.name} class="h-5 w-5" />
                </span>
                <span class="text-sm font-medium">{s.key}</span>
                <Icon name="arrowUpRight" class="h-4 w-4 -translate-x-1 opacity-0 transition-all group-hover:translate-x-0 group-hover:opacity-100" />
              </a>
            ))}
          </div>
        </div>

        <!-- Form (Netlify Forms — works automatically when deployed to Netlify) -->
        <form
          name="contact"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="rounded-2xl bg-white p-6 text-ink sm:p-7"
          data-contact-form
        >
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden">
            <label>Don't fill this out: <input name="bot-field" /></label>
          </p>

          <div class="grid gap-4">
            <label class="block">
              <span class="text-sm font-medium text-ink">Name</span>
              <input type="text" name="name" required placeholder="Your name"
                class="mt-1.5 w-full rounded-xl border border-ink/10 bg-surface-alt px-4 py-3 text-sm outline-none transition-colors focus:border-brand-400 focus:bg-white" />
            </label>
            <label class="block">
              <span class="text-sm font-medium text-ink">Email</span>
              <input type="email" name="email" required placeholder="you@email.com"
                class="mt-1.5 w-full rounded-xl border border-ink/10 bg-surface-alt px-4 py-3 text-sm outline-none transition-colors focus:border-brand-400 focus:bg-white" />
            </label>
            <label class="block">
              <span class="text-sm font-medium text-ink">Message</span>
              <textarea name="message" rows="4" required placeholder="Tell me about your idea..."
                class="mt-1.5 w-full resize-none rounded-xl border border-ink/10 bg-surface-alt px-4 py-3 text-sm outline-none transition-colors focus:border-brand-400 focus:bg-white"></textarea>
            </label>
            <button type="submit" class="btn-primary w-full">
              Send message <Icon name="arrowRight" class="h-4 w-4" />
            </button>
            <p class="hidden text-center text-sm font-medium text-brand-600" data-form-success>
              Thanks! Your message has been sent. ✦
            </p>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>
