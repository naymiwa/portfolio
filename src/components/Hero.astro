---
import { site } from '../data/site';
import Icon from './Icon.astro';

const socialList = [
  { key: 'github', href: site.socials.github, name: 'github' },
  { key: 'linkedin', href: site.socials.linkedin, name: 'linkedin' },
  { key: 'youtube', href: site.socials.youtube, name: 'youtube' },
].filter((s) => s.href);

// Curated tech stack — icon-only shields.io badges (languages, frameworks,
// ML, deployment, design tools), hand-picked for relevance to a Software
// Engineering Technology profile. Keep this list short so it fits the
// hero's existing empty space without adding visual bloat.
const techStack = [
  { name: 'Java', logo: 'openjdk', color: 'ED8B00', logoColor: 'white' },
  { name: 'Spring Boot', logo: 'springboot', color: '6DB33F', logoColor: 'white' },
  { name: 'JavaScript', logo: 'javascript', color: '323330', logoColor: '%23F7DF1E' },
  { name: 'C++', logo: 'c%2B%2B', color: '00599C', logoColor: 'white' },
  { name: 'Python', logo: 'python', color: '3670A0', logoColor: 'ffdd54' },
  { name: 'Tailwind CSS', logo: 'tailwind-css', color: '38B2AC', logoColor: 'white' },
  { name: 'PostgreSQL', logo: 'postgresql', color: '316192', logoColor: 'white' },
  { name: 'TensorFlow', logo: 'TensorFlow', color: 'FF6F00', logoColor: 'white' },
  { name: 'FastAPI', logo: 'fastapi', color: '005571', logoColor: 'white' },
  { name: 'GitHub', logo: 'github', color: '121011', logoColor: 'white' },
  { name: 'Figma', logo: 'figma', color: 'F24E1E', logoColor: 'white' },
  { name: 'Canva', logo: 'Canva', color: '00C4CC', logoColor: 'white' },
  { name: 'Netlify', logo: 'netlify', color: '000000', logoColor: '%2300C7B7' },
  { name: 'Render', logo: 'render', color: '46E3B7', logoColor: 'white' },
].map((t) => ({
  ...t,
  src: `https://img.shields.io/badge/-${t.color}.svg?style=for-the-badge&logo=${t.logo}&logoColor=${t.logoColor}`,
}));
// Slight alternating tilt so the row feels hand-placed rather than a rigid grid.
const tilt = ['-rotate-3', 'rotate-2', '-rotate-2', 'rotate-3', '-rotate-1', 'rotate-1'];
---
<section id="home" class="relative overflow-hidden pt-24 pb-12 sm:pt-28 sm:pb-16">
  <div class="container-content">
    <div class="mx-auto max-w-2xl text-center">
      <h1 data-reveal style="--reveal-delay:80ms" class="text-3xl font-bold leading-[1.1] text-ink sm:text-5xl md:text-6xl text-balance">
        {site.name}
      </h1>

      <p data-reveal style="--reveal-delay:140ms" class="mt-2 text-base font-medium text-brand-600 sm:text-lg">
        {site.role}
      </p>

      <div data-reveal style="--reveal-delay:200ms" class="mt-6 flex flex-wrap items-center justify-center gap-2">
        <a href="#projects" class="btn-primary px-5 py-2.5 text-sm">
          View my work <Icon name="arrowRight" class="h-4 w-4" />
        </a>
        <a href={site.cv} download class="btn-ghost px-5 py-2.5 text-sm">
          <Icon name="download" class="h-4 w-4" /> Download CV
        </a>
      </div>

      {socialList.length > 0 && (
        <div data-reveal style="--reveal-delay:260ms" class="mt-5 flex items-center justify-center gap-2">
          {socialList.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.key}
              class="grid h-8 w-8 place-items-center rounded-full border border-ink/10 bg-white text-ink-muted transition-all duration-200 hover:-translate-y-0.5 hover:border-brand-300 hover:text-brand-600"
            >
              <Icon name={s.name} class="h-4 w-4" />
            </a>
          ))}
        </div>
      )}

      {techStack.length > 0 && (
        <div
          data-reveal
          style="--reveal-delay:320ms"
          class="mx-auto mt-6 flex max-w-xl flex-wrap items-center justify-center gap-x-3 gap-y-2.5"
        >
          {techStack.map((t, i) => (
            <img
              src={t.src}
              alt={t.name}
              title={t.name}
              loading="lazy"
              class={`h-6 w-auto rounded-md shadow-sm transition-transform duration-200 hover:rotate-0 hover:scale-110 sm:h-7 ${tilt[i % tilt.length]}`}
            />
          ))}
        </div>
      )}
    </div>
  </div>
</section>
