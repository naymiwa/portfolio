---
import { site } from '../data/site';
import Icon from './Icon.astro';

const socialList = [
  { key: 'github', href: site.socials.github, name: 'github' },
  { key: 'linkedin', href: site.socials.linkedin, name: 'linkedin' },
  { key: 'instagram', href: site.socials.instagram, name: 'instagram' },
  { key: 'youtube', href: site.socials.youtube, name: 'youtube' },
].filter((s) => s.href);
---
<section id="home" class="relative overflow-hidden pt-24 pb-12 sm:pt-28 sm:pb-16">
  <div class="container-content">
    <div class="mx-auto max-w-2xl text-center">
      <h1 data-reveal style="--reveal-delay:80ms" class="text-3xl font-bold leading-[1.1] text-ink sm:text-5xl md:text-6xl text-balance">
        {site.name}
      </h1>

      <p data-reveal style="--reveal-delay:140ms" class="mt-2 text-base font-medium text-brand-600 sm:text-lg">
        {site.role}
      </p>

      <div data-reveal style="--reveal-delay:200ms" class="mt-6 flex flex-wrap items-center justify-center gap-2">
        <a href="#projects" class="btn-primary px-5 py-2.5 text-sm">
          View my work <Icon name="arrowRight" class="h-4 w-4" />
        </a>
        <a href="#contact" class="btn-ghost px-5 py-2.5 text-sm">Get in touch</a>
        <a href={site.cv} download class="btn-ghost px-5 py-2.5 text-sm">
          <Icon name="download" class="h-4 w-4" /> Download CV
        </a>
      </div>

      {socialList.length > 0 && (
        <div data-reveal style="--reveal-delay:260ms" class="mt-5 flex items-center justify-center gap-2">
          {socialList.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.key}
              class="grid h-8 w-8 place-items-center rounded-full border border-ink/10 bg-white text-ink-muted transition-all duration-200 hover:-translate-y-0.5 hover:border-brand-300 hover:text-brand-600"
            >
              <Icon name={s.name} class="h-4 w-4" />
            </a>
          ))}
        </div>
      )}
    </div>
  </div>
</section>
