---
import { site } from '../data/site';
import Icon from './Icon.astro';

const socialList = [
  { key: 'github', href: site.socials.github, name: 'github' },
  { key: 'linkedin', href: site.socials.linkedin, name: 'linkedin' },
  { key: 'instagram', href: site.socials.instagram, name: 'instagram' },
  { key: 'youtube', href: site.socials.youtube, name: 'youtube' },
].filter((s) => s.href);

// Split tagline to highlight one word
const parts = site.tagline.split(site.heroHighlight);
---
<section id="home" class="relative overflow-hidden pt-36 pb-20 sm:pt-44 sm:pb-28">
  <!-- Decorative brand blobs + bold solid shapes -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
    <div class="absolute -left-24 top-10 h-80 w-80 rounded-full bg-brand-300/40 blur-3xl animate-blob-drift"></div>
    <div class="absolute right-0 top-32 h-72 w-72 rounded-full bg-coral-300/30 blur-3xl animate-blob-drift" style="animation-delay:-6s"></div>
    <div class="absolute left-1/3 -bottom-10 h-72 w-72 rounded-full bg-sand-300/40 blur-3xl animate-blob-drift" style="animation-delay:-11s"></div>
    <!-- solid color accents -->
    <div class="absolute left-[8%] top-40 h-16 w-16 rounded-2xl bg-coral-500 rotate-12 animate-float opacity-90"></div>
    <div class="absolute right-[10%] top-24 h-14 w-14 rounded-full bg-sand-400 animate-float opacity-95" style="animation-delay:-3s"></div>
    <div class="absolute right-[16%] bottom-24 h-12 w-12 rounded-lg bg-brand-500 -rotate-12 animate-float" style="animation-delay:-5s"></div>
    <div class="absolute left-[14%] bottom-16 h-9 w-9 rounded-full bg-brand-500 animate-float" style="animation-delay:-2s"></div>
    <div class="absolute inset-0 grain opacity-[0.35]"></div>
  </div>

  <div class="container-content">
    <div class="mx-auto max-w-3xl text-center">
      <h1 data-reveal style="--reveal-delay:80ms" class="text-4xl font-bold leading-[1.05] text-ink sm:text-6xl md:text-7xl text-balance">
        {site.name}
      </h1>

      <p data-reveal style="--reveal-delay:150ms" class="mt-4 text-lg font-medium text-brand-600 sm:text-xl">
        {site.role}
      </p>

      <p data-reveal style="--reveal-delay:220ms" class="mx-auto mt-6 max-w-2xl text-base text-ink-muted sm:text-lg text-balance">
        {parts[0]}<span class="gradient-text font-semibold">{site.heroHighlight}</span>{parts[1]}
      </p>

      <div data-reveal style="--reveal-delay:300ms" class="mt-9 flex flex-wrap items-center justify-center gap-3">
        <a href="#projects" class="btn-primary" data-magnetic>
          View my work <Icon name="arrowRight" class="h-4 w-4" />
        </a>
        <a href="#contact" class="btn-ghost" data-magnetic>Get in touch</a>
        <a href={site.cv} download class="btn-ghost">
          <Icon name="download" class="h-4 w-4" /> Download CV
        </a>
      </div>

      {socialList.length > 0 && (
        <div data-reveal style="--reveal-delay:360ms" class="mt-8 flex items-center justify-center gap-3">
          {socialList.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.key}
              class="grid h-10 w-10 place-items-center rounded-full border border-ink/10 bg-white text-ink-muted transition-all duration-200 hover:-translate-y-0.5 hover:border-brand-300 hover:text-brand-600"
            >
              <Icon name={s.name} class="h-5 w-5" />
            </a>
          ))}
        </div>
      )}
    </div>

    <!-- Stats (solid blue / red / yellow blocks) -->
    <div data-reveal style="--reveal-delay:420ms" class="mx-auto mt-16 grid max-w-2xl grid-cols-3 gap-4">
      {site.stats.map((s, i) => {
        const styles = [
          'bg-brand-500 text-white',
          'bg-coral-500 text-white',
          'bg-sand-400 text-ink',
        ];
        const style = styles[i % 3];
        return (
          <div class={`rounded-2xl px-4 py-6 text-center shadow-card transition-transform duration-300 hover:-translate-y-1 ${style}`}>
            <div class="font-display text-3xl font-bold sm:text-4xl">{s.value}</div>
            <div class="mt-1 text-xs font-medium sm:text-sm opacity-90">{s.label}</div>
          </div>
        );
      })}
    </div>

    <a href="#about" class="mx-auto mt-16 flex w-max flex-col items-center gap-2 text-ink-faint" aria-label="Scroll down">
      <span class="text-xs uppercase tracking-[0.2em]">Scroll</span>
      <Icon name="arrowDown" class="h-5 w-5 animate-float" />
    </a>
  </div>
</section>
