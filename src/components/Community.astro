---
import { getCollection } from 'astro:content';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';

const items = (await getCollection('community')).sort(
  (a, b) => b.data.order - a.data.order
);
const rendered = await Promise.all(
  items.map(async (e) => ({ data: e.data, Content: (await e.render()).Content }))
);

const iconThemes = ['bg-brand-500 text-white', 'bg-coral-500 text-white', 'bg-sand-400 text-ink'];

const kindColor: Record<string, string> = {
  Community: 'bg-brand-50 text-brand-600 border-brand-100',
  Event: 'bg-coral-50 text-coral-600 border-coral-100',
  'Social Project': 'bg-sand-100 text-sand-700 border-sand-200',
  Experience: 'bg-surface-alt text-ink-muted border-ink/10',
};

const awards = [
  {
    title: '3rd Place Infographic UNITY Competition',
    issuer: 'UNITY Competition UIN Malang',
    date: 'Apr 2026',
    image: '/images/awards/unity-infographic.svg',
    alt: 'UNITY Competition infographic certificate',
  },
  {
    title: '1st Place BSEC Infographic Competition',
    issuer: 'STIE Surakarta',
    date: 'Mar 2026',
    image: '/images/awards/bsec-infographic.png',
    alt: 'BSEC Infographic Competition certificate',
  },
  {
    title: '3rd Place Poster IT FESTIVAL',
    issuer: 'IPB University',
    date: 'Aug 2025',
    image: '/images/awards/it-festival-ipb.svg',
    alt: 'IT Festival IPB poster competition award',
  },
];
---
<section id="community" class="section bg-surface-alt">
  <div class="container-content">
    <SectionHeading
      eyebrow="Beyond the code"
      title="Community & Recognition"
      subtitle="Volunteering, organizing, and hands-on projects that give back and grow people."
    />

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {rendered.map(({ data, Content }, i) => (
        <article data-reveal style={`--reveal-delay:${(i % 3) * 80}ms`} class="card group flex flex-col p-6 hover:-translate-y-1 hover:shadow-card-hover">
          <div class="flex items-center justify-between">
            {data.cover ? (
              <span class="grid h-11 w-11 shrink-0 place-items-center overflow-hidden rounded-xl bg-surface-alt ring-1 ring-ink/5">
                <img
                  src={data.cover}
                  alt={`${data.title} logo`}
                  loading="lazy"
                  class="h-full w-full object-contain"
                />
              </span>
            ) : (
              <span class={`grid h-11 w-11 place-items-center rounded-xl ${iconThemes[i % 3]}`}>
                <Icon name="users" class="h-5 w-5" />
              </span>
            )}
            <span class:list={['rounded-full border px-2.5 py-1 text-[11px] font-semibold', kindColor[data.kind]]}>
              {data.kind}
            </span>
          </div>
          <h3 class="mt-4 text-lg font-semibold text-ink">{data.title}</h3>
          {data.role && <p class="text-sm font-medium text-coral-600">{data.role}</p>}
          {data.date && <p class="text-xs text-ink-faint">{data.date}</p>}
          <div class="prose-portfolio mt-2 text-sm text-ink-muted">
            <Content />
          </div>
        </article>
      ))}

      <!-- Awards column (beside HAAJ & HIMAVO cards) -->
      <div
        data-reveal
        class="flex flex-col gap-4 sm:col-span-2 lg:col-span-1 lg:col-start-3 lg:row-start-1"
      >
        <div class="flex items-center gap-2.5 px-1">
          <span class="grid h-8 w-8 place-items-center rounded-lg bg-coral-500 text-white">
            <Icon name="star" class="h-4 w-4" />
          </span>
          <h3 class="text-base font-semibold text-ink">Awards & Competitions</h3>
        </div>
        {awards.map((a) => (
          <article class="card flex items-start gap-3.5 p-4 transition-all duration-300 hover:-translate-y-1 hover:shadow-card-hover">
            <div class="group relative shrink-0">
              <button
                type="button"
                data-lightbox
                data-src={a.image}
                data-caption={`${a.title} — ${a.issuer}`}
                aria-label={`View full ${a.alt}`}
                class="relative grid h-16 w-16 cursor-zoom-in place-items-center overflow-hidden rounded-lg bg-sand-100"
              >
                <Icon name="star" class="h-7 w-7 text-sand-600" />
                <img
                  src={a.image}
                  alt={a.alt}
                  loading="lazy"
                  class="absolute inset-0 h-full w-full object-cover"
                  onerror="this.remove()"
                />
              </button>
              <!-- Desktop hover preview (full image). Mobile/touch users tap the thumbnail to open the lightbox instead. -->
              <div class="pointer-events-none absolute left-1/2 top-full z-50 hidden -translate-x-1/2 pt-2 md:group-hover:block">
                <img
                  src={a.image}
                  alt={a.alt}
                  class="h-56 w-56 rounded-xl object-cover shadow-card-hover ring-1 ring-ink/10"
                  onerror="this.parentElement.remove()"
                />
              </div>
            </div>
            <div class="min-w-0">
              <h4 class="text-sm font-semibold leading-snug text-ink">{a.title}</h4>
              <p class="mt-0.5 text-[11px] text-ink-faint">{a.issuer} · {a.date}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
