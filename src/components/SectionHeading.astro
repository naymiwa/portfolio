---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
}
const { eyebrow, title, subtitle, align = 'left' } = Astro.props;
---
<div
  data-reveal
  class:list={[
    'max-w-2xl',
    align === 'center' && 'mx-auto text-center',
  ]}
>
  {eyebrow && (
    <span class="eyebrow">
      <span class="inline-block h-2.5 w-2.5 rounded-sm bg-coral-500"></span>
      <span class="inline-block h-2.5 w-2.5 rounded-sm bg-sand-400"></span>
      <span class="inline-block h-2.5 w-2.5 rounded-sm bg-brand-500"></span>
      {eyebrow}
    </span>
  )}
  <h2 class="mt-3 text-3xl sm:text-4xl md:text-[2.75rem] leading-[1.1] text-ink">
    {title}
  </h2>
  {subtitle && <p class="mt-4 text-base sm:text-lg text-ink-muted">{subtitle}</p>}
</div>
