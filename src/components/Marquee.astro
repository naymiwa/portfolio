---
// Bold scrolling strip in solid brand blue.
const words = [
  'Software Engineering',
  'UI / UX Design',
  'Web Development',
  'Robotics',
  'Astrophotography',
  'Machine Learning',
  'Creative Coding',
];
// Colored dot separators cycle through the palette.
const dot = ['bg-sand-400', 'bg-coral-500', 'bg-white'];
---
<div class="relative overflow-hidden bg-brand-500 py-4 sm:py-5" aria-hidden="true">
  <div class="flex w-max animate-marquee whitespace-nowrap">
    {[0, 1].map(() => (
      <ul class="flex items-center">
        {words.map((w, i) => (
          <li class="flex items-center">
            <span class="px-6 font-display text-lg font-semibold uppercase tracking-wide text-white sm:text-2xl">{w}</span>
            <span class={`h-2.5 w-2.5 rounded-full ${dot[i % 3]}`}></span>
          </li>
        ))}
      </ul>
    ))}
  </div>
</div>
