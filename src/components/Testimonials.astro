---
import { getCollection } from 'astro:content';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';

const items = (await getCollection('testimonials')).sort(
  (a, b) => a.data.order - b.data.order
);
const rendered = await Promise.all(
  items.map(async (e) => ({ data: e.data, Content: (await e.render()).Content }))
);
---
{rendered.length > 0 && (
  <section id="testimonials" class="section bg-surface-alt">
    <div class="container-content">
      <SectionHeading eyebrow="Kind words" title="What people say" align="center" />
      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {rendered.map(({ data, Content }, i) => (
          <figure data-reveal style={`--reveal-delay:${(i % 3) * 80}ms`} class="card flex flex-col p-7">
            <Icon name="quote" class="h-8 w-8 text-brand-200" />
            <blockquote class="prose-portfolio mt-3 flex-1 text-ink">
              <Content />
            </blockquote>
            <figcaption class="mt-5 flex items-center gap-3 border-t border-ink/[0.06] pt-4">
              <span class="grid h-10 w-10 place-items-center rounded-full bg-brand-100 font-display text-sm font-bold text-brand-600">
                {data.name[0]}
              </span>
              <span>
                <span class="block text-sm font-semibold text-ink">{data.name}</span>
                {data.title && <span class="block text-xs text-ink-faint">{data.title}</span>}
              </span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}
