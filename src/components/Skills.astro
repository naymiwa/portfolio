---
import { site } from '../data/site';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';

const groupIcon: Record<string, string> = {
  Development: 'code',
  'Design & Tools': 'palette',
  'Talents Mapping': 'spark',
};
---
<section id="skills" class="section">
  <div class="container-content">
    <SectionHeading
      eyebrow="What I do"
      title="Skills & strengths"
      subtitle="A blend of building, designing, and a mapped set of natural talents I lean on when I work."
    />

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {site.skills.map((group, i) => (
        <div data-reveal style={`--reveal-delay:${i * 90}ms`} class="card group p-6 hover:-translate-y-1 hover:shadow-card-hover">
          <div class="flex items-center gap-3">
            <span class="grid h-11 w-11 place-items-center rounded-xl bg-brand-50 text-brand-600 transition-colors duration-300 group-hover:bg-brand-500 group-hover:text-white">
              <Icon name={groupIcon[group.group] ?? 'star'} class="h-5 w-5" />
            </span>
            <h3 class="text-lg font-semibold text-ink">{group.group}</h3>
          </div>
          <ul class="mt-5 flex flex-wrap gap-2">
            {group.items.map((item) => (
              <li class="chip transition-colors duration-200 hover:border-brand-300 hover:text-brand-600">{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
