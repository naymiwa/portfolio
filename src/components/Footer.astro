---
import { site } from '../data/site';
import Icon from './Icon.astro';

const socialList = [
  { href: site.socials.github, name: 'github' },
  { href: site.socials.linkedin, name: 'linkedin' },
  { href: site.socials.instagram, name: 'instagram' },
  { href: site.socials.youtube, name: 'youtube' },
  { href: site.socials.email, name: 'email' },
].filter((s) => s.href);
const year = new Date().getFullYear();
---
<footer class="border-t border-ink/[0.06] bg-surface-alt">
  <div class="container-content py-12">
    <div class="flex flex-col items-center justify-between gap-8 md:flex-row md:items-start">
      <div class="max-w-sm text-center md:text-left">
        <a href="#home" class="inline-flex items-center gap-2.5">
          <span class="grid h-9 w-9 place-items-center rounded-full bg-brand-500 font-display text-sm font-bold text-white">{site.monogram}</span>
          <span class="font-display text-base font-semibold text-ink">{site.name}</span>
        </a>
        <p class="mt-3 text-sm text-ink-muted">{site.role} — driven by curiosity, building for impact.</p>
      </div>

      <nav class="flex flex-wrap justify-center gap-x-5 gap-y-2">
        {site.nav.map((item) => (
          <a href={item.href} class="text-sm text-ink-muted transition-colors hover:text-brand-600">{item.label}</a>
        ))}
      </nav>

      <div class="flex gap-2">
        {socialList.map((s) => (
          <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.name}
            class="grid h-10 w-10 place-items-center rounded-full border border-ink/10 bg-white text-ink-muted transition-all hover:-translate-y-0.5 hover:border-brand-300 hover:text-brand-600">
            <Icon name={s.name} class="h-5 w-5" />
          </a>
        ))}
      </div>
    </div>

    <div class="mt-10 flex flex-col items-center justify-between gap-3 border-t border-ink/[0.06] pt-6 text-xs text-ink-faint sm:flex-row">
      <p>© {year} {site.name}. All rights reserved.</p>
      <button type="button" data-back-to-top class="inline-flex items-center gap-1.5 rounded-full border border-ink/10 bg-white px-3 py-1.5 font-medium text-ink-muted transition-colors hover:text-brand-600">
        Back to top <Icon name="arrowUpRight" class="h-3.5 w-3.5" />
      </button>
    </div>
  </div>
</footer>
