---
import { site } from '../data/site';
import Icon from './Icon.astro';
---
<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 transition-all duration-300"
  data-nav
>
  <div class="container-content">
    <nav
      class="mt-4 flex items-center justify-between rounded-full border border-transparent bg-white/70 px-4 py-2.5 backdrop-blur-md transition-all duration-300"
      data-nav-bar
    >
      <a href="#home" class="group flex items-center gap-2.5" aria-label="Home">
        <span
          class="grid h-9 w-9 place-items-center rounded-full bg-brand-500 font-display text-sm font-bold text-white transition-transform duration-300 group-hover:scale-105"
          >{site.monogram}</span
        >
        <span class="hidden font-display text-sm font-semibold text-ink sm:block"
          >{site.name}</span
        >
      </a>

      <ul class="hidden items-center gap-1 lg:flex" data-nav-links>
        {site.nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="relative rounded-full px-3.5 py-2 text-sm font-medium text-ink-muted transition-colors duration-200 hover:text-brand-600 data-[active]:text-brand-600"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <div class="flex items-center gap-2">
        <a href="#contact" class="btn-primary hidden !px-5 !py-2.5 text-sm sm:inline-flex">
          Let's talk
        </a>
        <button
          type="button"
          class="grid h-10 w-10 place-items-center rounded-full border border-ink/10 text-ink lg:hidden"
          aria-label="Open menu"
          aria-expanded="false"
          data-menu-toggle
        >
          <Icon name="menu" class="h-5 w-5" />
        </button>
      </div>
    </nav>
  </div>

  <!-- Mobile menu -->
  <div
    class="fixed inset-0 z-40 hidden bg-ink/40 backdrop-blur-sm lg:hidden"
    data-menu-overlay
  >
    <div
      class="absolute right-4 top-4 w-[min(20rem,90vw)] rounded-3xl bg-white p-6 shadow-card-hover"
      data-menu-panel
    >
      <div class="flex items-center justify-between">
        <span class="font-display font-semibold">Menu</span>
        <button
          type="button"
          class="grid h-9 w-9 place-items-center rounded-full border border-ink/10"
          aria-label="Close menu"
          data-menu-close
        >
          <Icon name="close" class="h-5 w-5" />
        </button>
      </div>
      <ul class="mt-4 flex flex-col gap-1">
        {site.nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="block rounded-xl px-4 py-3 text-base font-medium text-ink hover:bg-surface-alt hover:text-brand-600"
              data-menu-link
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <a href="#contact" class="btn-primary mt-4 w-full" data-menu-link>Let's talk</a>
    </div>
  </div>
</header>
