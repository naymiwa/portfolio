---
import { site } from '../data/site';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
---
<section id="about" class="section bg-surface-alt">
  <div class="container-content">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <!-- Portrait: transparent cutout floating on a soft blue gradient that blends into the section -->
      <div data-reveal class="relative order-1 mx-auto w-full max-w-sm lg:order-none">
        <!-- soft, frameless brand gradient (no hard edges, bleeds into the section) -->
        <div aria-hidden="true" class="pointer-events-none absolute inset-0">
          <div class="absolute left-1/2 top-1/2 h-[125%] w-[120%] -translate-x-1/2 -translate-y-1/2 rounded-full bg-gradient-to-br from-brand-400 via-brand-500 to-brand-700 opacity-90 blur-[70px]"></div>
          <div class="absolute -left-6 top-2 h-44 w-44 rounded-full bg-coral-500/55 blur-[60px] animate-blob-drift"></div>
          <div class="absolute -right-4 bottom-6 h-48 w-48 rounded-full bg-sand-400/55 blur-[60px] animate-blob-drift" style="animation-delay:-7s"></div>
          <!-- soft white halo behind the subject so she pops -->
          <div class="absolute bottom-2 left-1/2 h-2/3 w-3/4 -translate-x-1/2 rounded-full bg-white/25 blur-[60px]"></div>
        </div>

        <!-- subject cutout, no frame -->
        <img
          src={site.about.portrait}
          alt={`Portrait of ${site.name}`}
          class="relative z-10 mx-auto w-full object-contain [filter:drop-shadow(0_18px_28px_rgba(17,31,66,0.35))]"
          loading="lazy"
          onerror="this.style.display='none'"
        />

        <!-- location badge -->
        <div class="absolute bottom-3 right-1 z-20 rounded-2xl bg-white/95 px-4 py-3 shadow-card backdrop-blur">
          <div class="flex items-center gap-2 text-sm font-semibold text-ink">
            <Icon name="pin" class="h-4 w-4 text-coral-500" /> Bogor, Indonesia
          </div>
        </div>
      </div>

      <!-- Copy -->
      <div>
        <SectionHeading eyebrow="About me" title="Curious by nature, driven by impact" />
        <p data-reveal class="mt-6 text-lg font-medium text-ink">{site.about.intro}</p>
        {site.about.body.map((p) => (
          <p data-reveal class="mt-4 text-ink-muted">{p}</p>
        ))}

        <dl data-reveal class="mt-8 grid grid-cols-2 gap-4">
          {site.about.facts.map((f) => (
            <div class="rounded-xl border border-ink/[0.06] bg-white px-4 py-3">
              <dt class="text-xs uppercase tracking-wide text-ink-faint">{f.label}</dt>
              <dd class="mt-0.5 text-sm font-semibold text-ink">{f.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </div>
</section>
